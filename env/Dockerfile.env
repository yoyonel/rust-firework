FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:${PATH}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    git \
    curl \
    ca-certificates \
    clang \
    lld \
    libglfw3-dev \
    libasound2-dev \
    libpulse-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    xvfb \
    x11-utils \
    mesa-utils \
    libgl1-mesa-dri \
    python3 \
    python3-pip \
    python3-pillow \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Rust Toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# Install go-task
ARG TASK_VERSION=3.38.0

RUN curl -fsSL "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin task

RUN pip3 install --break-system-packages --no-cache-dir \
    Pillow \
    numpy \
    scikit-image

WORKDIR /work
CMD ["task", "--list"]
