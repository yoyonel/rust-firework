FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ODIN_ROOT=/opt/odin
ENV PATH="/opt/odin:${PATH}:/root/.cargo/bin"

# Install Toolchain & System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    curl \
    wget \
    ca-certificates \
    clang \
    clang-tidy \
    lld \
    llvm \
    gcc \
    g++ \
    gdb \
    valgrind \
    heaptrack \
    libvulkan-dev \
    vulkan-tools \
    mesa-vulkan-drivers \
    glslang-tools \
    libglfw3-dev \
    libglm-dev \
    libasound2-dev \
    libpulse-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    xvfb \
    x11-utils \
    mesa-utils \
    libgl1-mesa-dri \
    python3 \
    python3-pip \
    python3-pillow \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Rust Toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# Install Odin Compiler Toolchain
ARG ODIN_VERSION=dev-2026-05
ARG ODIN_URL=https://github.com/odin-lang/Odin/releases/download/${ODIN_VERSION}/odin-linux-amd64-${ODIN_VERSION}.tar.gz
RUN mkdir -p /opt/odin && \
    curl -sSL "$ODIN_URL" | tar xz -C /opt/odin --strip-components=1 && \
    make -C /opt/odin/vendor/stb/src

# Install go-task, Hadolint, Actionlint, and Python Linters
ARG TASK_VERSION=3.38.0
ARG HADOLINT_VERSION=2.12.0
ARG ACTIONLINT_VERSION=1.7.4

RUN curl -fsSL "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin task && \
    curl -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-x86_64" -o /usr/local/bin/hadolint && chmod +x /usr/local/bin/hadolint && \
    curl -fsSL "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" | tar -xz -C /usr/local/bin actionlint

RUN pip3 install --break-system-packages --no-cache-dir \
    uv \
    Pillow \
    numpy \
    scikit-image \
    cmakelang \
    yamllint \
    pymarkdownlnt \
    gcovr

WORKDIR /work
CMD ["task", "--list"]
