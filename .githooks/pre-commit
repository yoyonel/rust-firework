#!/bin/sh
set -eu

# 🔒 Anti-Leak Identity Check
AUTHOR_EMAIL=$(git config user.email || true)
if echo "$AUTHOR_EMAIL" | grep -qiE 'letsignit|lsi|unowhy'; then
    echo "❌ ERREUR SÉCURITÉ : Tentative de commit avec l'email pro '$AUTHOR_EMAIL' !" >&2
    echo "👉 Ce projet perso exige l'identité yoyonel (yoyonel@hotmail.com)." >&2
    echo "   Exécuter : git config user.email 'yoyonel@hotmail.com'" >&2
    exit 1
fi

if command -v task >/dev/null 2>&1; then
    task test:gui-persistence-check
else
    ./scripts/check_gui_persistence.sh
fi
cargo fmt -- --check
